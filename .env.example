# =========================================================
# Copiar este archivo a .env y completar los valores
# cp .env.example .env
# =========================================================

# === SEGURIDAD ===
SECRET_KEY_BASE=                        # genera con: openssl rand -hex 64

# Claves de encriptación de base de datos (REQUERIDAS - genera con: bundle exec rails db:encryption:init)
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# === URL PUBLICA ===
FRONTEND_URL=https://chat.tudominio.com

# === POSTGRES ===
# Opción A: connection string completa (Neon, Supabase, Railway, etc.)
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Opción B: parámetros individuales (Postgres propio/Docker)
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=bitchat_production
POSTGRES_USERNAME=
POSTGRES_PASSWORD=

# Schema de Postgres (opcional, default: public)
POSTGRES_SCHEMA=public

# === REDIS ===
REDIS_URL=redis://host_o_ip:6379
# Si Redis tiene password:
# REDIS_URL=redis://:tu_password@host_o_ip:6379

# === MAIL ===
MAILER_SENDER_EMAIL=noreply@tudominio.com
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# === STORAGE ===
# 'local' guarda en el volumen Docker; cambiar a 's3' para produccion robusta
ACTIVE_STORAGE_SERVICE=local
